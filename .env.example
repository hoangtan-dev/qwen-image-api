# Application
DEBUG=false
APP_ENV=local
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Official Diffusers base model and Lightning adapter
MODEL_ID=Qwen/Qwen-Image-2512
LIGHTNING_MODEL_ID=lightx2v/Qwen-Image-2512-Lightning
LIGHTNING_WEIGHT_NAME=Qwen-Image-2512-Lightning-4steps-V1.0-fp32.safetensors

# Runtime device and weight dtype
DEVICE=cuda
TORCH_DTYPE=bfloat16

# FP8 reduces transformer memory usage; requires a compatible GPU
QUANTIZE_TRANSFORMER_FP8=true

# Compile the transformer for faster subsequent generations
COMPILE_MODEL=true

# Run one generation during startup to trigger compilation
WARMUP_MODEL=true

# Set false for API-only development without downloading model weights
LOAD_MODEL_ON_STARTUP=true

# Lightning defaults and request size limits
DEFAULT_NUM_INFERENCE_STEPS=4
DEFAULT_TRUE_CFG_SCALE=1.0
MAX_WIDTH=1664
MAX_HEIGHT=1664
